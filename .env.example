# ============================
# Stackwise Environment Config
# ============================

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stackwise

# SMTP Email (Gmail App Password — placeholder, fill in later)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-app@gmail.com
SMTP_PASS=YOUR_16_CHAR_APP_PASSWORD_HERE

# Application URLs
APP_URL=http://localhost:8080
LANDING_URL=http://localhost:5173

# Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-64-character-hex-string
