# ============================
# SupplyIQ — Environment Config
# ============================
#
# For local development, copy this to .env
# For production, set these in your deployment platform (Cloudflare Workers, etc.)

# ─── Database (PostgreSQL) ────────────────────────────────
# Local: postgres://user:password@localhost:5432/supplyiq
# Cloud: postgres://user:password@host.aws.neon.tech/supplyiq?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/supplyiq

# ─── SMTP Email ───────────────────────────────────────────
# Gmail: smtp.gmail.com / 587 / your-app@gmail.com / app-password
# SendGrid: smtp.sendgrid.net / 587 / apikey / SG.xxx
# Resend: smtp.resend.com / 587 / resend / re_xxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-app@gmail.com
SMTP_PASS=YOUR_16_CHAR_APP_PASSWORD_HERE

# ─── URLs ─────────────────────────────────────────────────
# Production: https://api.supplyiq.co.za (backend) & https://supplyiq.co.za (landing)
APP_URL=http://localhost:8082
LANDING_URL=http://localhost:5173

# ─── Session ──────────────────────────────────────────────
# Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-character-hex-string
