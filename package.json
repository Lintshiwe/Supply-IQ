{
  "name": "stackwise-application",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "backend",
    "desktop"
  ],
  "scripts": {
    "dev:app": "bun run --cwd backend dev",
    "dev:desktop": "bun run --cwd desktop tauri dev",
    "build:app": "bun run --cwd backend build",
    "build:desktop": "bun run --cwd desktop tauri build",
    "db:generate": "bun run --cwd backend drizzle-kit generate",
    "db:migrate": "bun run --cwd backend drizzle-kit migrate",
    "db:seed": "bun run --cwd backend src/server/db/seed.ts",
    "lint": "bun run --cwd backend eslint ."
  }
}
